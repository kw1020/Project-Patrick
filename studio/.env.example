# Copy to .env (setup.sh does this) and fill in. Never commit .env.

# ---- Patrick ----
# console.anthropic.com: writes scripts and captions
ANTHROPIC_API_KEY=
# anything; the phone asks for it once
PATRICK_PASSCODE=
STUDIO_NICHE=flipping thrift-store finds for profit and using AI to make money
# short-video-maker voice (am_adam, am_eric, af_heart, bm_george, ...)
STUDIO_VOICE=am_michael
# SELF_ONLY until TikTok approves your app's audit, then PUBLIC_TO_EVERYONE.
STUDIO_TIKTOK_PRIVACY=SELF_ONLY

# ---- Free keys for the render tools ----
# aistudio.google.com/app/apikey (free): OpenShorts picks the best moments
GEMINI_API_KEY=
# pexels.com/api (free): stock footage for faceless shorts
PEXELS_API_KEY=

# ---- Postiz ----
# Postiz > Settings > Public API, after you sign up at :4007
POSTIZ_API_KEY=
# the URL you open Postiz at (must match your OAuth redirect URLs)
POSTIZ_PUBLIC_URL=http://localhost:4007
# set true after you create your account
POSTIZ_DISABLE_REGISTRATION=false
# setup.sh fills this in
POSTIZ_JWT_SECRET=
# setup.sh fills this in
POSTIZ_DB_PASSWORD=

# Platform developer apps (see studio/README.md, "Connect the platforms")
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
# Instagram Business/Creator via a Facebook page
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# or Instagram login without a Facebook page
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ---- Optional ----
# PATRICK_PORT=3000
# POSTIZ_PORT=4007
# POSTIZ_TAG=latest
# latest = better voice/captions, needs more RAM; latest-cuda for NVIDIA
# SHORTMAKER_TAG=latest-tiny
# WHISPER_MODEL=small
