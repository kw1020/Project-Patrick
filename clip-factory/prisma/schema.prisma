generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Every GTA 6 streamer the Scout has seen, plus approved YouTube channels. Only approved ones get clipped.
// YouTube rows: platform "youtube", twitchId "yt:<channelId>", login = @handle without the @, name = channel title.
// twitchId is the unique identity. login is unique PER PLATFORM (kept by the app, see src/lib/streamers.ts), so the
// same name can be a Twitch streamer and a YouTube channel at once. Only a plain index here: a database-level
// @@unique([platform, login]) makes `prisma db push` stop with a data-loss warning on existing databases.
model Streamer {
  id            String    @id @default(cuid())
  twitchId      String    @unique
  login         String
  name          String
  platform      String    @default("twitch") // twitch | youtube
  approved      Boolean   @default(false)
  approvalNote  String?
  approvedAt    DateTime? // when Krew last approved them (Creators page); null on rows approved before v1.7.2 -> createdAt
  facecam       String?   // "x,y,w,h" fractions of the frame, for the facecam-on-top layout
  facecamAuto   String?   // v1.9.0: webcam spot found automatically ("x,y,w,h"); a typed-in facecam always wins
  profileImage  String?
  isLive        Boolean   @default(false)
  viewers       Int       @default(0)
  peakViewers   Int       @default(0)
  streamTitle   String?
  gameName      String?   // Twitch category while live (any-game mode tracks approved streamers in every game)
  streamId      String?
  liveSince     DateTime?
  lastSeenAt    DateTime?
  chatRate      Float     @default(0) // messages/sec, last minute (approved + live only)
  chatAvg       Float     @default(0) // messages/sec, 5-min rolling average
  paused        Boolean   @default(false) // still approved, but the clips poller / spike detector / YouTube scanner skip them (Creators page)
  campaignId    String?   // v1.9.1: the Whop Content Rewards campaign this creator's clips are for (captions follow its rules)
  campaign      Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  followers     Int?      // v1.9.5: Twitch follower count (needs the Twitch user token from Settings), refreshed at most daily
  followersAt   DateTime? // v1.9.5: when followers was last fetched
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  moments       Moment[]
  videos        YouTubeVideo[]
  suggestion    Suggestion?
  edits         Edit[]

  @@index([platform, login])
}

// A moment worth clipping. Phase 1 source = twitch_clip; Phase 2 adds chat spikes.
model Moment {
  id           String   @id @default(cuid())
  streamerId   String
  streamer     Streamer @relation(fields: [streamerId], references: [id], onDelete: Cascade)
  timestamp    DateTime
  spikeScore   Float    @default(0)
  source       String // chat | twitch_clip | youtube (vodId = video id, vodOffset = peak center)
  twitchClipId String?  @unique
  sourceUrl    String?
  sourceTitle  String?
  sourceViews  Int      @default(0)
  gameName     String?  // game being played (Twitch category name); null = GTA 6 for older rows
  vodId        String?
  vodOffset    Int? // seconds into the VOD
  stats        String? // JSON: chat-spike numbers + sample chat lines (for the Judge)
  category     String?  // funny | gaming (first guess: chat laughs, Twitch category, clip/video title); null on older rows
  createdAt    DateTime @default(now())
  clips        Clip[]
}

model Clip {
  id         String   @id @default(cuid())
  momentId   String
  moment     Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  rawPath    String?
  finalPath  String?
  transcript String?
  duration   Float?
  words       String? // JSON [{start,end,word}] for burned captions
  winStart    Float?  // where the kept window starts in the raw file
  winLength   Float?  // length of that window (duration = the edited clip, shorter after jump cuts); null on older rows -> duration
  editStyle   String? // hype | clean | meme: the style it was last cut with (v1.7.3)
  editNote    String? // set when the styled edit failed and the plain edit was used instead
  payoffAt    Float?  // v1.8.0: the payoff moment, seconds into the raw file (punch-in + where the window was placed)
  wordsFull   Boolean @default(false) // v1.8.0: words are timed in the whole raw file (older rows: inside the window)
  layout      String? // v1.9.0: split | fullcam | blur, the layout it was last cut with (null on older clips)
  camInfo     String? // v1.9.0: JSON face/webcam detection for the window it was measured on (src/lib/layout.ts CamInfo)
  score       Float?  // Judge score 1-10
  hookText    String? // Judge's on-screen hook
  hashtags    String? // space-separated
  judgeReason String?
  judgeObservations String? // v1.9.4: what the Judge saw/heard (1-2 sentences, written before it scored)
  judgeFrames       Int?    // v1.9.4: how many stills it looked at (0 = text only; null = judged before v1.9.4)
  judgeTokensIn     Int?    // v1.9.4: tokens the Judge call used (all input incl. images) for the cost on Settings
  judgeTokensOut    Int?
  judgeHookOk       Boolean? // v1.9.8: the Judge said the first ~1.5s hook (null = judged before v1.9.8)
  judgePayoffIn     Boolean? // v1.9.8: the Judge said the payoff is inside the window it was shown
  judgePayoff       String?  // v1.9.8: the payoff in one line, as the Judge named it ("" / null = it could not name one, score capped at 4)
  judgeAudio        String?  // v1.9.8: the <audio_summary> block the Judge read (debugging / "what it heard")
  platformInfo      String?  // v1.9.8: JSON {file: ffprobe facts, render: what was burned in} for the Platform check
  category    String? // funny | gaming: the moment's guess at first, replaced by the Judge's label; null on older rows
  postError   String? // last YouTube upload error
  channelId   String? // v1.9.5: the Channel this clip goes to when Krew picked one on To post (null = by category, src/lib/channels.ts)
  cutPlan     String? // v1.9.6: JSON of the last render's edit {segs (window seconds), punchStart, duration} (Supreme QA cut checks)
  supremePick Boolean @default(false) // v1.9.6: the Supreme Judge picked it (shown first on To post / starred on the Queue)
  supremeRank Int? // v1.9.6: its place in that channel's picks (1 = best)
  supremeReason String? // v1.9.6: one line on why
  supremeAt   DateTime? // v1.9.6: when it was picked
  supremeChannelId String? // v1.9.6: the channel it was picked for
  qa          String? // v1.9.6: JSON video check (src/lib/qa.ts QaResult): free ffmpeg checks + the vision check
  qaAt        DateTime? // v1.9.6: when the video was last checked
  title      String?
  caption    String?
  // processing -> pending (waiting for review) -> approved | rejected -> posted ; failed on error
  // v1.9.4: pending nobody reviewed -> expired (video deleted by retention, row deleted after retainRowsDays)
  status     String   @default("processing")
  stage      String?  // grab | transcribe | judge | cut (while processing), post (uploading)
  stageAt    DateTime? // when `stage` last changed (Workroom "time in this step"); null on older rows -> use updatedAt
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  posts      Post[]
}

model Post {
  id       String   @id @default(cuid())
  clipId   String
  clip     Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)
  platform   String // youtube | tiktok | instagram
  accountId  String?
  account    Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  status     String   @default("live") // live | draft (TikTok: waiting in Krew's inbox) | failed
  publishId  String?  // TikTok upload id (to follow the draft)
  externalId String?  // YouTube / TikTok video id (for view counts)
  url        String?
  postedAt   DateTime @default(now())
  views      Int?
  likes      Int?
  comments   Int?
  syncedAt   DateTime?
  error      String?
  campaignLink String? // v1.9.1: where Krew submitted this post on Whop (Content Rewards)
  campaignId   String? // v1.9.1: the campaign it was submitted to (plain id, no relation: deleting a campaign keeps the post)
  channelId    String? // v1.9.5: the Channel (ViceCityClips…) of the account it went to (plain id, no relation)
  stats      PostStat[]
}

// Single-row settings (id = "main").
model Settings {
  id               String  @id @default("main")
  spikeEnabled     Boolean @default(true)
  spikeMultiplier  Float   @default(3) // chat msgs/sec >= N x 5-min average
  judgeEnabled     Boolean @default(true)
  minScore         Float   @default(7) // Judge auto-reject below this (v1.9.8: 6 -> 7, about the top third reaches Krew)
  judgeLearns      Boolean @default(true) // feed results from Krew's accounts into the Judge
  // Phase 2 single-account settings; Phase 3 moved these onto each Account. Kept so old databases update cleanly.
  ytAutoUpload     Boolean @default(false)
  ytPrivacy        String  @default("public")
  clipMinSec       Int     @default(15)
  clipMaxSec       Int     @default(35) // v1.8.0: 45 -> 35 (existing installs moved once, see migratedAnyGame)
  minClipViews     Int     @default(25) // Twitch clips need at least this many views
  clipLookbackHrs  Int     @default(168) // v1.8.0: 7 days (was 24h); existing 24 moved to 168 once
  layout           String  @default("auto") // v1.9.0: auto | split | fullcam | blur ("facecam" = old name of split)
  captions         Boolean @default(true)
  scoutPaused      Boolean @default(false)
  gameMode         String  @default("any") // any (approved streamers in any game, default since v1.8.0) | gta6
  clipFunny        Boolean @default(true) // "What to clip": funny moments (don't have to be gaming)
  clipGaming       Boolean @default(true) // "What to clip": gaming moments
  ytScanEnabled      Boolean @default(true) // YouTube scanner: most-replayed parts of approved channels' new videos
  ytVideosPerChannel Int     @default(3)
  ytMomentsPerVideo  Int     @default(3)
  ytMaxVideoAgeDays  Int     @default(14)
  ytSuggestRegion    String  @default("US") // YouTube suggestions: country of the "trending" charts (ISO 3166-1 alpha-2)
  editStyle          String  @default("hype") // hype | clean | meme (v1.7.3 editing styles)
  standoutMin         Float   @default(2) // v1.8.0: a Twitch clip needs >= N x that creator's usual (median) clip views
  maxPerCreatorPerRun Int     @default(2) // v1.8.0: fair mix, at most this many new clips per creator per scan
  jumpCuts            String  @default("light") // v1.8.0: off | light | normal (only real silence is cut)
  migratedAnyGame     Boolean @default(false) // v1.8.0 one-time move: gta6 -> any, lookback 24h -> 7d, max 45s -> 35s
  migratedAutoLayout  Boolean @default(false) // v1.9.0 one-time move: layout blur -> auto
  channelName         String  @default("ViceCityClips") // v1.9.1: Krew's channel, shown in the header + the watermark
  watermark           Boolean @default(true) // v1.9.1: burn a small "@<channelName>" into new clips (bottom right)
  // v1.9.4 Storage: auto-delete clips nobody uses (src/workers/retention.ts). Halved in disk-pressure mode.
  retainRejectedHrs   Int     @default(6)  // rejected / auto-rejected: raw + final deleted after this
  retainPendingHrs    Int     @default(48) // never reviewed: final deleted after this, then status "expired"
  retainApprovedDays  Int     @default(5)  // approved but never posted: final deleted (the row stays)
  retainPostedDays    Int     @default(3)  // posted: final deleted (it's on the platform already)
  retainRawHrs        Int     @default(6)  // raw: deleted once cut + reviewed, and at most this long after the cut
  retainRowsDays      Int     @default(7)  // rejected / expired clip rows deleted after this (clips with posts are kept)
  migratedChannels    Boolean @default(false) // v1.9.5 one-time: first Channel made from channelName, existing accounts put in it
  supremePerChannel   Int     @default(5) // v1.9.6: Supreme Judge picks per channel per run
  supremeDailyCents   Int     @default(25) // v1.9.6: daily cap for Supreme Judge + video checks, in US cents
  // v1.9.8 quality over quantity (Krew: "lesser of the clips that are lower quality and more clips that are just more higher quality")
  maxPerCreatorPerHour Int    @default(3)     // at most this many clips per creator per hour reach review; the best are kept
  migratedMinScore7    Boolean @default(false) // v1.9.8 one-time move: minScore 6 -> 7
  editBpm             Float   @default(128) // v2.0.0 Edits: steady beat when no song is picked
  editVibe            String  @default("hype") // v2.0.0 Edits: hype | funny | smooth
  editLength          Int     @default(20) // v2.0.0 Edits: 15 | 20 | 30 seconds
  editAuto            Boolean @default(false) // v2.0.0 Edits: make a daily edit of each creator with enough good moments
  editCreatorAudio    Boolean @default(true) // v2.0.0 Edits: keep the creator's audio (quieter) under the edit, else silent
}

// v1.9.5: one of Krew's brands (e.g. "ViceCityClips") = up to one YouTube + one TikTok + one Instagram account that all get the same
// clips. kinds = which clips go there by default (comma list of gaming | funny | edits). No relations: plain ids on
// Account.homeChannelId / Clip.channelId / Post.channelId, so deleting a channel never deletes posts.
model Channel {
  id        String   @id @default(cuid())
  name      String
  kinds     String   @default("gaming,funny") // which clip types it takes (comma list of gaming | funny | edits)
  focus     String   @default("any") // gta = GTA 6 clips of any type (ViceCityClips) | any = clips whose type is in kinds
  color     String?
  createdAt DateTime @default(now())
}

// v1.9.1 Campaign mode: a Whop Content Rewards campaign. Creators are tagged with one (Streamer.campaignId) and their
// captions follow its rules (src/lib/social.ts brandedCaption / checkCampaignCaption). Nothing is blocked: Krew decides.
model Campaign {
  id              String     @id @default(cuid())
  name            String
  source          String     @default("whop")
  link            String?    // the campaign's page on Whop
  rules           String?    // free text: the campaign's caption rules (the Judge reads them)
  requiredText    String?    // lines that must appear in the caption, one per line (e.g. "@kaicenat", "#ad")
  bannedWords     String?    // comma or line separated
  maxCaptionChars Int?
  active          Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  streamers       Streamer[]
}

// Connected posting accounts. Several per platform (e.g. two YouTube channels, a TikTok).
// v1.9.5: mode "manual" = just a handle Krew posts to by hand (refreshToken ""), any platform incl. instagram;
// platform "twitch" (mode api) = the Twitch user token used only to read follower counts (never posts).
model Account {
  id           String    @id @default(cuid())
  platform     String    // youtube | tiktok | instagram | twitch (follower counts only)
  channelId    String?   // YouTube channel id / TikTok open_id
  channelTitle String?   // shown in the dashboard
  username     String?   // TikTok @handle (for post links)
  refreshToken String
  accessToken  String?
  expiresAt    DateTime?
  autoPost     Boolean   @default(false) // post (YouTube) / send draft (TikTok) when Krew approves
  privacy      String    @default("public") // YouTube: public | unlisted | private
  error        String?   // set when the platform rejects the token (reconnect needed)
  mode         String    @default("api") // v1.9.5: api (OAuth-connected) | manual (a handle Krew posts to by hand)
  handle       String?   // v1.9.5: e.g. "@vicecityclips" (manual accounts; shown on To post)
  homeChannelId String?  // v1.9.5: the Channel this account belongs to (Account.channelId is the platform's own id)
  disabled     Boolean   @default(false) // v1.9.5: skipped by Post to all, not needed for "posted everywhere" (why: in error)
  scopes       String?   // v2.0.3: permissions the platform granted (comma list; Instagram insights, TikTok video.publish)
  directPost   Boolean   @default(false) // v2.0.3: TikTok Direct Post (private until TikTok audits the app) instead of an inbox draft
  createdAt    DateTime  @default(now())
  posts        Post[]
  editPosts    EditPost[]

  @@unique([platform, channelId])
}

// v1.9.6: what the Supreme Judge and its video checks cost, one row per Claude call (summed per day for the daily cap).
// purpose: supreme | qa. The per-clip Judge is not written here. No unique constraint (plain index on day).
model AiSpend {
  id        String   @id @default(cuid())
  day       String   // YYYY-MM-DD, the computer's local day
  model     String
  purpose   String   @default("supreme")
  cents     Float
  createdAt DateTime @default(now())

  @@index([day])
}

// View-count history for each post (one row per sync where something changed).
model PostStat {
  id       String   @id @default(cuid())
  postId   String
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  at       DateTime @default(now())
  views    Int
  likes    Int?
  comments Int?
}

// YouTube videos the scanner has looked at, so each one is fetched once.
// status: done (peaks sent) | partial (line was full, rest next scan) | old | no_heatmap (re-checked every 6h)
// | off_funny / off_gaming (that kind of clip was off in Settings; looked at again once it is switched back on)
model YouTubeVideo {
  id         String    @id // YouTube video id
  streamerId String
  streamer   Streamer  @relation(fields: [streamerId], references: [id], onDelete: Cascade)
  title      String?
  uploadedAt DateTime?
  status     String
  note       String?
  checkedAt  DateTime  @default(now())
}

// Streamers the Suggestions scanner thinks Krew could approve (big + clippable). Never approves anyone:
// Krew approves from the Streamers page with one click (a note is optional). One row per streamer.
// status: pending (shown) | dismissed ("Not now", hidden until dismissedUntil) | approved
// platform: twitch | youtube (each keeps its own top 25). YouTube ones come from the trending charts (YouTube Data API key).
model Suggestion {
  id             String    @id @default(cuid())
  streamerId     String    @unique
  streamer       Streamer  @relation(fields: [streamerId], references: [id], onDelete: Cascade)
  platform       String    @default("twitch")
  score          Float
  reasons        String    // JSON array of short plain-English strings
  evidence       String?   // exact quote from their bio / stream title / channel description that says clips are allowed (<= 160 chars)
  evidenceSource String?   // bio | title | description
  subscribers    Int?      // YouTube: subscriber count when scored (null = hidden by the channel)
  videoId        String?   // YouTube: their biggest trending video when scored
  videoTitle     String?
  videoViews     Int?
  viewers        Int       @default(0) // viewers when scored (the Scout resets Streamer.viewers for non-GTA streams)
  gameName       String?   // category when scored
  status         String    @default("pending")
  dismissedUntil DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ---- v2.0.0 Edits (beat-synced montages of one creator's best moments, for the edit channel) ----
// No music is ever put into an edit: Krew adds the sound in TikTok/Reels. finalWithBeatPath is a preview with the timing
// track (or a click) mixed in, only for checking the sync. Files live in STORAGE_DIR/edits/<id>/.
model Edit {
  id                String    @id @default(cuid())
  streamerId        String
  streamer          Streamer  @relation(fields: [streamerId], references: [id], onDelete: Cascade)
  format            String    @default("montage") // montage (5-12 moments) | clipedit (one clip, then the edit from the drop)
  sourceClipId      String?   // clipedit: the clip it was made from (plain id, no relation: the clip may be deleted later)
  vibe              String    // hype | funny | smooth
  lengthSec         Int       // asked-for length (the edit is rounded to whole bars)
  bpm               Float     // the tempo it was cut to (Settings.editBpm, or found in the timing track)
  beatOffset        Float     @default(0) // where in the timing track the edit starts (seconds): start the sound there
  status            String    @default("processing") // processing | pending | approved | rejected | posted | failed
  stage             String?   // picking | downloading | beats | rendering (while processing), post (uploading)
  stageAt           DateTime?
  error             String?
  slices            String?   // JSON: the plan (picks, beat grid, slices, effects) + render report
  finalPath         String?   // the no-music edit (the one to post)
  finalWithBeatPath String?   // preview with the beat mixed in (never post this one)
  title             String?
  caption           String?
  timingTrack       String?   // file name in the music folder, null = steady beat at bpm
  creatorAudio      Boolean   @default(true) // keep the creator's audio (quieter) under the edit
  captions          Boolean   @default(false) // word captions (edits normally have none)
  endText           String?   // text over the last bar ("follow for more"), null = none
  duration          Float?    // real length of the finished edit (seconds)
  platformInfo      String?   // v1.9.8 Platform check facts for the final (ffprobe + render facts JSON), like Clip.platformInfo
  postError         String?
  theme             String?   // v2.0.5 Top 5: funny | gaming | gta | creator (streamerId = that creator, else the #1 entry's creator)
  creators          String?   // v2.0.5 Top 5: JSON [{id, login, name, platform}] of every creator in it (caption credits)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  posts             EditPost[]
}

// Where an edit went (mirrors Post, which needs a clip).
model EditPost {
  id         String    @id @default(cuid())
  editId     String
  edit       Edit      @relation(fields: [editId], references: [id], onDelete: Cascade)
  platform   String    // youtube | tiktok | instagram
  accountId  String?
  account    Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  channelId  String?   // the Channel of the account (plain id, like Post.channelId)
  status     String    @default("live") // live | draft (TikTok inbox) | failed
  publishId  String?
  externalId String?
  url        String?
  postedAt   DateTime  @default(now())
  views      Int?
  likes      Int?
  comments   Int?
  syncedAt   DateTime?
  error      String?
}
