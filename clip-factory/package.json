{
  "name": "clip-factory",
  "version": "0.1.0",
  "private": true,
  "description": "GTA 6 Twitch clip factory: scout, grabber, cutter, review dashboard",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "worker": "tsx src/workers/index.ts",
    "db:push": "prisma db push --skip-generate",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "doctor": "tsx scripts/doctor.ts",
    "postinstall": "prisma generate",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.9.0",
    "@prisma/client": "6.19.3",
    "bullmq": "5.81.5",
    "ioredis": "5.11.1",
    "next": "15.5.29",
    "prisma": "6.19.3",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "tsx": "4.21.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.1",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
