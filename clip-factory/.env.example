# Copy to .env and fill in. Never commit .env or share it.
# Put each key right after its = sign. No spaces, no quotes, nothing else on the line.

# Required: from dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: the Judge scores clips. Leave empty and clips go to review unscored.
ANTHROPIC_API_KEY=

# Optional: posting (see README)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Optional: only if using the Whisper API instead of local captions
OPENAI_API_KEY=

# Defaults work for local dev; docker compose overrides these.
DATABASE_URL=file:./dev.db
REDIS_URL=redis://localhost:6379
STORAGE_DIR=./storage
# Captions: local | openai | off
WHISPER_ENGINE=local
WHISPER_MODEL=base.en

# Where you open the dashboard. Google's redirect URL is APP_URL + /api/youtube/callback
APP_URL=http://localhost:3000
