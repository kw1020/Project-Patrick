# Copy to .env and fill in. Never commit .env or share it.
# Put each key right after its = sign. No spaces, no quotes, nothing else on the line.

# Required: from dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: the Judge scores clips. Leave empty and clips go to review unscored.
ANTHROPIC_API_KEY=

# Optional: YouTube suggestions on the Streamers page. Free API key, steps in README (Suggestions).
YOUTUBE_API_KEY=

# Optional: posting (see README)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Optional: TikTok Direct Post (private until TikTok approves your app). Put on after the steps in README (TikTok), else leave empty.
TIKTOK_DIRECT_POST=

# Optional: Instagram Reels posting. Instagram App ID and Instagram App Secret from your Meta app (README: Connect Instagram).
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
# Optional: only if you use an https tunnel. Default is APP_URL with https + /api/instagram/callback.
INSTAGRAM_REDIRECT_URI=
# Optional: put off if Instagram says "Invalid scope" when connecting (then Reel views aren't read, likes and comments still are).
INSTAGRAM_INSIGHTS=

# Optional: only if using the Whisper API instead of local captions
OPENAI_API_KEY=

# Where clips are stored on your PC. Leave empty for the clip-factory/storage folder.
# Example for a second drive: CLIP_STORAGE_DIR=D:/ClipFactory/storage
# Use forward slashes. Create the folder first, then restart Clip Factory.
CLIP_STORAGE_DIR=

# Defaults work for local dev; docker compose overrides these.
DATABASE_URL=file:./dev.db
REDIS_URL=redis://localhost:6379
STORAGE_DIR=./storage
# Captions: local | openai | off
WHISPER_ENGINE=local
WHISPER_MODEL=base.en

# Where you open the dashboard. Google's redirect URL is APP_URL + /api/youtube/callback
APP_URL=http://localhost:3000

# Speed (v2.0.9). How many clips download at once (network-bound, 3 is safe; 4-6 on fast internet).
GRAB_CONCURRENCY=3
# How many clips get captions at once (CPU). 2 on a PC with 8+ cores.
TRANSCRIBE_CONCURRENCY=1
# How many clips are cut at once (CPU-heavy). 2 on a PC with 8+ cores, 3 with 12+.
CUT_CONCURRENCY=1
# How many clips can be in the line at once. Raise to 20-24 together with the numbers above.
MAX_BACKLOG=12
# Pieces of a video section downloaded in parallel by yt-dlp.
YTDLP_FRAGMENTS=4
