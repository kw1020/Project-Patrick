# Copy to .env and fill in. Never commit .env.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
ANTHROPIC_API_KEY=        # Phase 2 (Judge)
YOUTUBE_CLIENT_ID=        # Phase 2 (auto-upload)
YOUTUBE_CLIENT_SECRET=    # Phase 2
OPENAI_API_KEY=           # only if using the Whisper API instead of local faster-whisper

# Defaults work for local dev; docker compose overrides these.
DATABASE_URL=file:./dev.db
REDIS_URL=redis://localhost:6379
STORAGE_DIR=./storage
# local | openai | off
WHISPER_ENGINE=local
WHISPER_MODEL=base.en
