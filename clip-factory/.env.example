# Copy to .env and fill in. Never commit .env.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
ANTHROPIC_API_KEY=        # Judge (scores clips). Empty = clips go to review unscored.
YOUTUBE_CLIENT_ID=        # YouTube upload (see README)
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=        # TikTok drafts (see README)
TIKTOK_CLIENT_SECRET=
OPENAI_API_KEY=           # only if using the Whisper API instead of local faster-whisper

# Defaults work for local dev; docker compose overrides these.
DATABASE_URL=file:./dev.db
REDIS_URL=redis://localhost:6379
STORAGE_DIR=./storage
# local | openai | off
WHISPER_ENGINE=local
WHISPER_MODEL=base.en

# Where you open the dashboard. Google's redirect URL is APP_URL + /api/youtube/callback
APP_URL=http://localhost:3000
# JUDGE_MODEL=claude-sonnet-5-5
